# ───────────────────────────────────────
# SMS Peculiar International College
# Environment Configuration
# ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ── Database ──
DB_HOST=localhost
DB_NAME=sms_peculiar_college
DB_USER=peculiar_user
DB_PASS=change-this-to-a-strong-random-password

# ── Application ──
APP_ENV=production
APP_DEBUG=false
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=change-this-to-a-random-64-char-hex-key
APP_NAME="Peculiar International College - School Management System"
APP_URL=https://yourdomain.com
# Base path the app is served under, e.g. "/sms-peculiar-college" when hosted at
# http://localhost/sms-peculiar-college/ or "/" for the domain root.
BASE_URL=/sms-peculiar-college

# ── Payments (Paystack) ──
# Get keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# ── School Info ──
SCHOOL_NAME="Peculiar International College"
SCHOOL_ADDRESS="After Technical College Bukuru, Trade Centre Kuru, Plateau State"
SCHOOL_PHONE=+234-XXX-XXX-XXXX
SCHOOL_EMAIL=info@peculiarcollege.edu.ng

# ── SMS / API Keys ──
AT_API_KEY=
AT_USERNAME=

# ── Email (SMTP) ──
# Set these if using SMTP instead of PHP mail(). If left empty, PHP mail() is used.
# For production, configure SMTP to ensure reliable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# ── PHP Settings ──
PHP_DISPLAY_ERRORS=0
PHP_ERROR_REPORTING=E_ALL

# ── Upload Limits ──
UPLOAD_MAX_SIZE=2097152

# ── Maintenance Mode ──
# Set APP_MAINTENANCE=true to take the site offline (non-admins see the
# maintenance page). Admin users, or GET requests carrying
# `?down_for_maintenance=<token>` (token derived from APP_KEY), can still reach
# the site to bring it back up.
APP_MAINTENANCE=false
APP_MAINTENANCE_MESSAGE="We are currently performing scheduled maintenance. Please check back shortly."
APP_MAINTENANCE_RETRY=3600
