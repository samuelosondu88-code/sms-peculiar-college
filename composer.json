{
    "name": "peculiar/sms-peculiar-college",
    "description": "Peculiar International College - School Management System (procedural-to-modular PHP refactor)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "monolog/monolog": "^3.6",
        "mpdf/mpdf": "^8.2",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"echo 'Run: composer dump-autoload -o for optimized classmap.\\n';\""
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": false,
        "allow-plugins": {
            "mpdf/mpdf": true
        }
    }
}