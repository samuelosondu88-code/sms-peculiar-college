# Uploads folder: never allow script execution. Files here are user-supplied.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php[0-9]|phar|shtml|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI